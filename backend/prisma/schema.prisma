generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  BUTTON
  LIST
  INTERACTIVE
  SYSTEM
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum HrOfficerRole {
  ADMIN
  OFFICER
}

enum HrOfficerStatus {
  ACTIVE
  INACTIVE
}

enum AnalyticsEventType {
  SESSION_STARTED
  MAIN_MENU_VIEWED
  SERVICE_SELECTED
  INFORMATION_PROVIDED
  BOT_COMPLETED
  ESCALATION_CREATED
  UNRECOGNIZED_INPUT
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
}

enum BillingRateUploadStatus {
  UPLOADED
  VALIDATED
  REJECTED
  APPROVED
}

enum PayslipBatchStatus {
  DRAFT
  CALCULATED
  IN_REVIEW
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
}

enum PayslipStatus {
  CALCULATED
  IN_REVIEW
  HELD
  APPROVED
  REJECTED
}

enum AllowanceClass {
  PAYSLIP_MAPPED_TAXABLE
  PAYSLIP_MAPPED_NONTAXABLE
  IGNORED
  MANUAL
  UNMAPPED
}

enum PayslipLineKind {
  BASE
  ARREARS
}

model Employee {
  id             String         @id @default(uuid())
  employeeNumber String         @unique
  fullName       String
  phoneNumber    String         @unique
  department     String
  jobTitle       String
  email          String?
  emailUpdatedAt DateTime?
  status         EmployeeStatus @default(ACTIVE)

  sessions    ChatSession[]
  escalations Escalation[]
  analyticsEvents AnalyticsEvent[]
  billingRateRows BillingRateRow[]
  payslips        Payslip[]
  deliveries      PayslipDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeNumber])
  @@index([phoneNumber])
  @@index([email])
}

model HrOfficer {
  id           String          @id @default(uuid())
  fullName     String
  email        String          @unique
  passwordHash String
  refreshTokenHash String?
  passwordResetTokenHash String?
  passwordResetTokenExpiresAt DateTime?
  role         HrOfficerRole   @default(OFFICER)
  status       HrOfficerStatus @default(ACTIVE)

  assignedEscalations Escalation[] @relation("EscalationAssignee")
  sentMessages        ChatMessage[] @relation("HrOfficerMessages")
  auditLogs           AuditLog[]
  billingRateUploads    BillingRateUpload[] @relation("BillingRateUploads")
  payslipBatchesCreated PayslipBatch[] @relation("PayslipBatchesCreated")
  approvedPayslipBatches PayslipBatch[] @relation("PayslipBatchesApproved")
  payslipWorkloadClaims PayslipWorkloadClaim[]
  payslipsReviewed           Payslip[]                @relation("PayslipsReviewed")
  payslipsApproved           Payslip[]                @relation("PayslipsApproved")
  payslipBatchesRejected     PayslipBatch[]           @relation("PayslipBatchesRejected")
  payslipBatchApprovalsMade  PayslipBatchApproval[]   @relation("PayslipBatchApprovalsMade")
  reviewWorkbooksExported    ReviewWorkbook[]         @relation("ReviewWorkbooksExported")
  reviewWorkbookPreviewsCreated ReviewWorkbookPreview[] @relation("ReviewWorkbookPreviewsCreated")
  payslipSettingsUpdated     PayslipSettings[]        @relation("PayslipSettingsUpdated")
  payslipDispatchesCreated   PayslipEmailDispatch[]   @relation("PayslipDispatchesCreated")
  payslipDispatchesApproved  PayslipEmailDispatch[]   @relation("PayslipDispatchesApproved")
  emailSuppressionsAcknowledged EmailSuppression[]    @relation("EmailSuppressionsAcknowledged")
  emailSuppressionsResolved    EmailSuppression[]      @relation("EmailSuppressionsResolved")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([passwordResetTokenHash])
}

model ChatSession {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  currentState String

  isActive Boolean @default(true)

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  lastReadByHrAt DateTime?
  endedAt        DateTime?

  messages    ChatMessage[]
  escalations Escalation[]
  feedbacks   Feedback[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isActive])
  @@index([lastActivityAt])
  @@index([lastReadByHrAt])
}

model ChatMessage {
  id String @id @default(uuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  direction   MessageDirection
  messageType MessageType
  content     String

  sentByHrOfficerId String?
  sentByHrOfficer   HrOfficer? @relation("HrOfficerMessages", fields: [sentByHrOfficerId], references: [id], onDelete: SetNull)

  metaMessageId String? @unique
  rawPayload    Json?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([sentByHrOfficerId])
}

model Escalation {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  reason String

  status EscalationStatus @default(OPEN)

  assignedHrOfficerId String?
  assignedHrOfficer   HrOfficer? @relation("EscalationAssignee", fields: [assignedHrOfficerId], references: [id], onDelete: SetNull)

  category     String?
  documentType String?

  resolutionNote String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  feedback   Feedback?
  analyticsEvents AnalyticsEvent[]

  @@index([status])
  @@index([employeeId])
  @@index([assignedHrOfficerId])
  @@index([category])
  @@index([documentType])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(uuid())

  actorType String

  actorHrOfficerId String?
  actorHrOfficer   HrOfficer? @relation(fields: [actorHrOfficerId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorHrOfficerId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id String @id @default(uuid())

  type AnalyticsEventType

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  escalationId String?
  escalation   Escalation? @relation(fields: [escalationId], references: [id], onDelete: SetNull)

  metadata Json?

  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([sessionId])
  @@index([employeeId])
  @@index([escalationId])
  @@index([createdAt])
}

model Feedback {
  id           String      @id @default(uuid())
  escalationId String      @unique
  escalation   Escalation  @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  createdAt    DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model AccountingCompany {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  payrollPeriods     PayrollPeriod[]
  billingRateUploads BillingRateUpload[]
  payslipBatches     PayslipBatch[]
  payslipWorkloadClaims PayslipWorkloadClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PayrollPeriod {
  id                  String            @id @default(uuid())
  accountingCompanyId String
  accountingCompany   AccountingCompany @relation(fields: [accountingCompanyId], references: [id], onDelete: Restrict)

  name      String
  startDate DateTime
  endDate   DateTime
  month     String?
  year      Int?
  status    PayrollPeriodStatus @default(OPEN)

  billingRateUploads BillingRateUpload[]
  payslipBatches     PayslipBatch[]
  payslipWorkloadClaims PayslipWorkloadClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountingCompanyId, startDate, endDate])
  @@index([accountingCompanyId])
  @@index([status])
  @@index([startDate, endDate])
}

// Dynamic authorization: officers claim a company-period workload; administrators remain global.
model PayslipWorkloadClaim {
  id String @id @default(uuid())
  accountingCompanyId String
  accountingCompany AccountingCompany @relation(fields: [accountingCompanyId], references: [id], onDelete: Cascade)
  payrollPeriodId String
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  claimedById String?
  claimedBy HrOfficer? @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt DateTime?
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountingCompanyId, payrollPeriodId])
  @@index([claimedById])
}

model BillingRateUpload {
  id                  String                @id @default(uuid())
  accountingCompanyId String
  accountingCompany   AccountingCompany     @relation(fields: [accountingCompanyId], references: [id], onDelete: Restrict)
  payrollPeriodId     String
  payrollPeriod       PayrollPeriod         @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)

  version        Int
  status         BillingRateUploadStatus @default(UPLOADED)
  fileName       String
  sourceFileHash String?
  uploadedById   String
  uploadedBy     HrOfficer @relation("BillingRateUploads", fields: [uploadedById], references: [id], onDelete: Restrict)

  rowCount        Int @default(0)
  validRowCount   Int @default(0)
  invalidRowCount Int @default(0)

  rows           BillingRateRow[]
  payslipBatches PayslipBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountingCompanyId, payrollPeriodId, version])
  @@index([accountingCompanyId, payrollPeriodId])
  @@index([status])
  @@index([uploadedById])
  @@index([createdAt])
}

model BillingRateRow {
  id                  String            @id @default(uuid())
  billingRateUploadId String
  billingRateUpload   BillingRateUpload @relation(fields: [billingRateUploadId], references: [id], onDelete: Cascade)

  rowNumber  Int
  staffId    String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  rawData          Json
  normalizedData   Json?
  validationErrors Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([billingRateUploadId, rowNumber])
  @@index([staffId])
  @@index([employeeId])
  @@index([billingRateUploadId])
}

model PayslipBatch {
  id                  String            @id @default(uuid())
  accountingCompanyId String
  accountingCompany   AccountingCompany @relation(fields: [accountingCompanyId], references: [id], onDelete: Restrict)
  payrollPeriodId     String
  payrollPeriod       PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  billingRateUploadId String
  billingRateUpload   BillingRateUpload @relation(fields: [billingRateUploadId], references: [id], onDelete: Restrict)

  version     Int
  status      PayslipBatchStatus @default(DRAFT)
  createdById String
  createdBy   HrOfficer @relation("PayslipBatchesCreated", fields: [createdById], references: [id], onDelete: Restrict)

  calculatedAt DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   HrOfficer? @relation("PayslipBatchesApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      HrOfficer? @relation("PayslipBatchesRejected", fields: [rejectedById], references: [id], onDelete: SetNull)
  approvals       PayslipBatchApproval[]

  payslips Payslip[]
  reviewWorkbooks ReviewWorkbook[]
  previews        ReviewWorkbookPreview[]
  emailDispatches PayslipEmailDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountingCompanyId, payrollPeriodId, version])
  @@index([accountingCompanyId, payrollPeriodId])
  @@index([billingRateUploadId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model Payslip {
  id               String         @id @default(uuid())
  payslipBatchId   String
  payslipBatch     PayslipBatch   @relation(fields: [payslipBatchId], references: [id], onDelete: Cascade)
  billingRateRowId String
  billingRateRow   BillingRateRow @relation(fields: [billingRateRowId], references: [id], onDelete: Restrict)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  staffId String
  status  PayslipStatus @default(CALCULATED)

  calculationInputs  Json
  calculationOutputs Json
  reviewData         Json?

  reviewedById       String?
  reviewedBy         HrOfficer? @relation("PayslipsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote         String?
  changedSinceReview Boolean    @default(false)
  approvedById       String?
  approvedBy         HrOfficer? @relation("PayslipsApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  contentHash        String?
  carriedForward     Boolean    @default(false)

  reviewedAt DateTime?
  approvedAt DateTime?

  lines      PayslipLine[]
  pdf        PayslipPdf?
  deliveries PayslipDelivery[]

  supersedesPayslipId String?
  supersedesPayslip   Payslip?  @relation("PayslipVersions", fields: [supersedesPayslipId], references: [id], onDelete: Restrict)
  replacementPayslips Payslip[] @relation("PayslipVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payslipBatchId, staffId])
  @@index([staffId])
  @@index([employeeId])
  @@index([billingRateRowId])
  @@index([status])
  @@index([createdAt])
  @@index([supersedesPayslipId])
  @@index([payslipBatchId, status])
}

model PayslipBatchApproval {
  id              String       @id @default(uuid())
  payslipBatchId  String
  payslipBatch    PayslipBatch @relation(fields: [payslipBatchId], references: [id], onDelete: Cascade)
  approvedById    String
  approvedBy      HrOfficer    @relation("PayslipBatchApprovalsMade", fields: [approvedById], references: [id], onDelete: Restrict)
  batchVersion    Int
  approvedCount   Int
  unresolvedCount Int
  partial         Boolean
  reason          String?
  createdAt       DateTime     @default(now())

  @@index([payslipBatchId])
}

model AllowanceDefinition {
  id                   String         @id @default(uuid())
  canonicalName        String         @unique
  sourceSheet          String
  sourceHeader         String
  classification       AllowanceClass
  affectsGrossEarnings Boolean        @default(false)
  affectsNetServiceFee Boolean        @default(false)
  supportsArrears      Boolean        @default(false)
  displayLabel         String
  sortOrder            Int            @default(0)
  effectiveFrom        DateTime       @default(now())

  lines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classification])
  @@index([canonicalName])
}

model PayslipLine {
  id                    String              @id @default(uuid())
  payslipId             String
  payslip               Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  allowanceDefinitionId String?
  allowanceDefinition   AllowanceDefinition? @relation(fields: [allowanceDefinitionId], references: [id], onDelete: SetNull)

  name         String
  kind         PayslipLineKind
  parentLineId String?
  parentLine   PayslipLine?        @relation("LineArrears", fields: [parentLineId], references: [id], onDelete: SetNull)
  childLines   PayslipLine[]       @relation("LineArrears")

  amount     Decimal        @db.Decimal(18, 4)
  taxClass   AllowanceClass
  sortOrder  Int            @default(0)
  sourceCell String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payslipId])
  @@index([allowanceDefinitionId])
  @@index([parentLineId])
}

model ReviewWorkbook {
  id             String       @id @default(uuid())
  payslipBatchId String
  payslipBatch   PayslipBatch @relation(fields: [payslipBatchId], references: [id], onDelete: Cascade)

  batchVersion   Int?
  batchStateHash String?
  exportedById   String?
  exportedBy     HrOfficer? @relation("ReviewWorkbooksExported", fields: [exportedById], references: [id], onDelete: SetNull)

  exportHash   String    @unique
  exportedAt   DateTime  @default(now())
  reuploadedAt DateTime?
  diff         Json?

  previews ReviewWorkbookPreview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payslipBatchId])
}

model ReviewWorkbookPreview {
  id               String         @id @default(uuid())
  payslipBatchId   String
  payslipBatch     PayslipBatch   @relation(fields: [payslipBatchId], references: [id], onDelete: Cascade)
  reviewWorkbookId String
  reviewWorkbook   ReviewWorkbook @relation(fields: [reviewWorkbookId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        HrOfficer      @relation("ReviewWorkbookPreviewsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  fileHash         String
  batchStateHash   String
  payload          Json
  expiresAt        DateTime
  appliedAt        DateTime?
  result           Json?
  createdAt        DateTime       @default(now())

  @@index([payslipBatchId, createdAt])
}

model PayslipSettings {
  id                       String     @id @default("default")
  varianceThresholdPercent Int        @default(20)
  updatedById              String?
  updatedBy                HrOfficer? @relation("PayslipSettingsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt                DateTime   @updatedAt
}

enum PayslipPdfStatus {
  PENDING
  GENERATING
  READY
  FAILED
  EXPIRED
}

model PayslipPdfBlob {
  id              String       @id @default(uuid())
  contentHash     String
  templateVersion String
  bytes           Bytes
  sizeBytes       Int
  sha256          String
  createdAt       DateTime     @default(now())
  pdfs            PayslipPdf[]

  @@unique([contentHash, templateVersion])
}

model PayslipPdf {
  id           String           @id @default(uuid())
  payslipId    String           @unique
  payslip      Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  status       PayslipPdfStatus @default(PENDING)
  blobId       String?
  blob         PayslipPdfBlob?  @relation(fields: [blobId], references: [id], onDelete: Restrict)
  attempts     Int              @default(0)
  errorMessage String?
  generatedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([expiresAt])
}

enum PayslipDeliveryStatus {
  PENDING
  PROCESSING
  SUBMITTED
  DELIVERED
  DELIVERY_DELAYED
  RETRY_SCHEDULED
  BOUNCED_SOFT
  BOUNCED_HARD
  COMPLAINED
  REJECTED
  FAILED
  SUBMISSION_UNKNOWN
  SKIPPED
  CANCELLED
}

enum PayslipDeliveryAttemptOutcome {
  ACCEPTED
  CONFIRMED_FAILURE
  SUBMISSION_UNKNOWN
}

enum PayslipDeliveryAttemptTrigger {
  AUTOMATIC
  MANUAL
}

enum PayslipEmailDispatchStatus {
  PENDING_APPROVAL
  APPROVED
  SENDING
  PAUSED
  COMPLETED
  COMPLETED_WITH_FAILURES
  CANCELLED
}

enum PayslipEmailDispatchMode {
  LIVE
  TEST
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  SES_ACCOUNT_LIST
}

enum EmailSuppressionStatus {
  ACTIVE
  RESOLVED
}

model PayslipEmailDispatch {
  id                    String                     @id @default(uuid())
  payslipBatchId        String
  payslipBatch          PayslipBatch               @relation(fields: [payslipBatchId], references: [id], onDelete: Restrict)
  status                PayslipEmailDispatchStatus @default(PENDING_APPROVAL)
  mode                  PayslipEmailDispatchMode   @default(LIVE)
  createdById           String
  createdBy             HrOfficer                  @relation("PayslipDispatchesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById          String?
  approvedBy            HrOfficer?                 @relation("PayslipDispatchesApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  recipientCount        Int
  skippedCount          Int
  includeCarriedForward Boolean                    @default(false)
  pauseReason           String?
  blockedReason         String?
  completedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deliveries            PayslipDelivery[]

  @@index([payslipBatchId])
  @@index([status])
}

model PayslipDelivery {
  id                     String                 @id @default(uuid())
  payslipId              String
  payslip                Payslip                @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  payslipBatchId         String
  accountingCompanyId    String
  payrollPeriodId        String
  employeeId             String?
  employee               Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  dispatchId             String?
  dispatch               PayslipEmailDispatch?  @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  status                 PayslipDeliveryStatus  @default(PENDING)
  isTest                 Boolean                @default(false)
  isCorrection           Boolean                @default(false)
  correctsDeliveryId     String?
  recipientEmailSnapshot String?
  recipientMasked        String?
  contentHash            String?
  attemptCount           Int                    @default(0)
  autoRetryCount         Int                    @default(0)
  softBounceRetryCount   Int                    @default(0)
  sesMessageId           String?
  submittedAt            DateTime?
  deliveredAt            DateTime?
  bouncedAt              DateTime?
  lastAttemptAt          DateTime?
  lastEventAt            DateTime?
  nextAttemptAt          DateTime?
  claimedAt              DateTime?
  claimedBy              String?
  lastErrorCode          String?
  lastErrorMessage       String?
  skipReason             String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  attempts               PayslipDeliveryAttempt[]

  @@index([payslipBatchId, status])
  @@index([dispatchId, status])
  @@index([status, nextAttemptAt])
  @@index([sesMessageId])
}

model PayslipDeliveryAttempt {
  id                     String                         @id @default(uuid())
  deliveryId             String
  delivery               PayslipDelivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber          Int
  trigger                PayslipDeliveryAttemptTrigger
  triggeredByHrOfficerId String?
  startedAt              DateTime
  finishedAt             DateTime?
  outcome                PayslipDeliveryAttemptOutcome?
  sesMessageId           String?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime                       @default(now())

  @@unique([deliveryId, attemptNumber])
}

model SesNotificationEvent {
  id                String    @id @default(uuid())
  snsMessageId      String    @unique
  eventType         String
  sesMessageId      String?
  deliveryId        String?
  eventTimestamp    DateTime?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  processingOutcome String?
  processingError   String?
  minimalPayload    Json

  @@index([sesMessageId])
  @@index([deliveryId])
  @@index([processedAt])
}

model EmailSuppression {
  id                    String                 @id @default(uuid())
  emailNormalized       String
  emailMasked           String
  reason                EmailSuppressionReason
  status                EmailSuppressionStatus @default(ACTIVE)
  detail                String?
  createdFromDeliveryId String?
  acknowledgedById      String?
  acknowledgedBy        HrOfficer?             @relation("EmailSuppressionsAcknowledged", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt        DateTime?
  resolvedById          String?
  resolvedBy            HrOfficer?             @relation("EmailSuppressionsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt            DateTime?
  resolutionNote        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([emailNormalized, status])
  @@index([status, acknowledgedAt])
}


